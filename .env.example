# Configuración del cliente de Firebase.
#
# Copia este fichero a .env.local y rellena los valores. Obtenerlos:
#
#   firebase apps:sdkconfig WEB 1:854295039681:web:1181b841906dba24160e40 \
#     --project planu-app
#
# No son secretos —viajan en el bundle del cliente— pero no se versionan para
# que cada entorno apunte a su propio proyecto de Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=planu-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=planu-app
VITE_FIREBASE_STORAGE_BUCKET=planu-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=1:854295039681:web:1181b841906dba24160e40

# Inferencia de IA en la nube. La ejecución en el dispositivo es gratis; la de
# la nube factura por token, así que está cerrada por defecto. Con "true" se
# habilita, pero sólo para cuentas con el claim `premium`.
# Requiere plan Blaze y App Check antes de abrirlo a terceros.
VITE_AI_CLOUD_FALLBACK=false

# Observabilidad. Sin DSN no se envía ningún error: es opcional y el repo
# funciona sin cuenta de Sentry.
VITE_SENTRY_DSN=
# Versión desplegada, para agrupar errores por release. En CI: el sha del commit.
VITE_RELEASE=

# Subida de source maps a Sentry. Sin ellos, una traza de producción es código
# minificado e ilegible; con ellos, fichero y línea del fuente original.
#
# El interruptor es SENTRY_UPLOAD, y sólo lo pone el despliegue a producción.
# Así `npm run build` en tu máquina y en CI sigue sin red y sin token, y no se
# crea una release en Sentry por cada rama y cada PR.
#
# Ojo con SENTRY_AUTH_TOKEN: éste **sí** es un secreto, a diferencia del DSN y
# de las claves de Firebase, que viajan en el bundle del cliente. No lleva
# prefijo VITE_ justamente para que Vite no pueda inlinearlo.
SENTRY_UPLOAD=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
