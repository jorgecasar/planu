# Configuración del cliente de Firebase.
#
# Copia este fichero a .env.local y rellena los valores. Obtenerlos:
#
#   firebase apps:sdkconfig WEB 1:854295039681:web:1181b841906dba24160e40 \
#     --project planu-app
#
# No son secretos —viajan en el bundle del cliente— pero no se versionan para
# que cada entorno apunte a su propio proyecto de Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=planu-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=planu-app
VITE_FIREBASE_STORAGE_BUCKET=planu-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=1:854295039681:web:1181b841906dba24160e40

# Inferencia de IA en la nube. La ejecución en el dispositivo es gratis; la de
# la nube factura por token, así que está cerrada por defecto. Con "true" se
# habilita, pero sólo para cuentas con el claim `premium`.
# Requiere plan Blaze y App Check antes de abrirlo a terceros.
VITE_AI_CLOUD_FALLBACK=false
