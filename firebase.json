{
	"hosting": {
		"public": "apps/web/dist",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"rewrites": [{ "source": "**", "destination": "/index.html" }]
	},
	"firestore": [
		{
			"database": "planu",
			"rules": "firestore.rules",
			"indexes": "firestore.indexes.json"
		}
	],
	"storage": {
		"rules": "storage.rules"
	},
	"emulators": {
		"auth": { "port": 9099 },
		"firestore": { "port": 8181 },
		"storage": { "port": 9199 },
		"hosting": { "port": 5050 },
		"ui": { "enabled": true, "port": 4000 },
		"singleProjectMode": true
	}
}
