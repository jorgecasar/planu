{
	"name": "planu",
	"version": "0.0.0",
	"private": true,
	"description": "planu \u2014 planificador de eventos con web components (monorepo root).",
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"setup": "npm install && node scripts/setup-skills.mjs",
		"setup:skills": "node scripts/setup-skills.mjs",
		"dev": "npm run dev --workspace @planu/web",
		"build": "npm run build --workspace @planu/web",
		"preview": "npm run preview --workspace @planu/web",
		"test": "npm run test --workspace @planu/web",
		"test:e2e": "npm run test:e2e --workspace @planu/web",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:lit": "npm run lint:lit --workspace @planu/web",
		"typecheck": "npm run typecheck --workspace @planu/web",
		"emulators": "firebase emulators:start",
		"localize:extract": "npm run localize:extract --workspace @planu/web",
		"localize:build": "npm run localize:build --workspace @planu/web"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@commitlint/cli": "^20.2.0",
		"@commitlint/config-conventional": "^20.2.0",
		"typescript": "^5.9.3"
	}
}
