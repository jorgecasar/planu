{
	"name": "@planu/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit",
		"lint:lit": "lit-analyzer src",
		"localize:extract": "lit-localize extract",
		"localize:build": "lit-localize build",
		"test:rules": "vitest run --config vitest.rules.config.ts",
		"test:arch": "vitest run --config vitest.arch.config.ts"
	},
	"dependencies": {
		"@awesome.me/webawesome": "^3.11.0",
		"@lit-labs/router": "^0.1.4",
		"@lit/context": "^1.1.6",
		"@lit/localize": "^0.12.2",
		"@lit/task": "^1.0.3",
		"@sentry/browser": "^10.70.0",
		"firebase": "^12.17.1",
		"lit": "^3.3.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.0",
		"@firebase/rules-unit-testing": "^5.0.1",
		"@lit/localize-tools": "^0.8.2",
		"@playwright/test": "^1.57.0",
		"@sentry/vite-plugin": "^5.4.0",
		"@tsconfig/strictest": "^2.0.8",
		"@vitest/browser": "^4.0.15",
		"@vitest/browser-playwright": "^4.0.15",
		"@vitest/coverage-v8": "^4.0.15",
		"axe-core": "^4.11.1",
		"lit-analyzer": "^2.0.3",
		"playwright": "^1.57.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.7",
		"vitest": "^4.0.15"
	}
}
